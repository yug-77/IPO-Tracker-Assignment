<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <RelativeLayout
        android:id="@+id/topActionBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="45dp"
        android:paddingHorizontal="16dp"
        android:background="#1E1E1E"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Mainboard IPO"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#FFFFFF"
                android:layout_marginEnd="16dp"/>
            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#FFFFFF"/>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/toggleContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/topActionBar"
        android:layout_margin="16dp"
        android:background="#5C4BBA"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnCurrentUpcoming"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#1E1E1E"
            android:text="Current &amp; Upcoming"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnListed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#5C4BBA"
            android:text="Listed"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ipoRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toggleContainer"
        android:layout_above="@+id/bottomNavBar"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="#1E1E1E"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout android:id="@+id/tabMainboard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_compass" android:tint="#BB86FC"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mainboard" android:textSize="10sp" android:textColor="#BB86FC"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/tabSme" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_agenda" android:tint="#888888"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SME IPO" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/tabBids" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_edit" android:tint="#888888"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bids" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/tabAllotment" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_info_details" android:tint="#888888"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allotment" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/tabNews" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_gallery" android:tint="#888888"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="News" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
